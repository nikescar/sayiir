%%% upload_to_cdn (node)
%%% Entry: run
%%% Dependencies: {}
```node
function run(input) {
    const uploadId = input.upload_id;
    return {
        upload_id: uploadId,
        cdn_url: `https://cdn.example.com/${uploadId}/video.mp4`
    };
}
