%%% timestamp_task (rust)
%%% Entry: run
%%% Dependencies: {"chrono":"0.4"}
```rust
use serde_json::{json, Value};
use chrono::Utc;

fn run(_input: Value) -> Result<Value, String> {
    let now = Utc::now();
    Ok(json!({"timestamp": now.to_rfc3339()}))
}
```

